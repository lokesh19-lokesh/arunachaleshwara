# ==============================================================================
# ARUNACHALESHWARA TOURS & TRAVELS - APACHE CONFIGURATION (.htaccess)
# Domain: https://arunachaleshwaratoursandtravels.in
# Optimised for SEO, Security, Fast Caching & Performance
# ==============================================================================

# Disable Directory Browsing
Options -Indexes

# Set Server Signature Off
ServerSignature Off

# Default Charset
AddDefaultCharset UTF-8

# ------------------------------------------------------------------------------
# 1. URL REWRITING & CANONICAL REDIRECTS (HTTPS & NON-WWW)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://arunachaleshwaratoursandtravels.in/$1 [R=301,L]

  # Redirect WWW to Non-WWW (Canonical Domain)
  RewriteCond %{HTTP_HOST} ^www\.arunachaleshwaratoursandtravels\.in$ [NC]
  RewriteRule ^(.*)$ https://arunachaleshwaratoursandtravels.in/$1 [R=301,L]

  # Redirect Old Legacy Domain if pointed to same server
  RewriteCond %{HTTP_HOST} ^(www\.)?arunachaleshwaratravels\.com$ [NC]
  RewriteRule ^(.*)$ https://arunachaleshwaratoursandtravels.in/$1 [R=301,L]

  # Redirect index.html to Root URL (Avoid duplicate content penalties)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
  RewriteRule ^index\.html$ https://arunachaleshwaratoursandtravels.in/ [R=301,L]

  # Clean URLs - Allow accessing page without .html extension
  # (e.g. /accommodation loads /accommodation.html internally)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 2. CUSTOM ERROR DOCUMENTS
# ------------------------------------------------------------------------------
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html

# ------------------------------------------------------------------------------
# 3. SECURITY HEADERS & PERMISSIONS
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"

  # Prevent clickjacking / frame embedding except same origin
  Header set X-Frame-Options "SAMEORIGIN"

  # Cross-site scripting (XSS) filter protection
  Header set X-XSS-Protection "1; mode=block"

  # Strict Referrer Policy for user privacy and security
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict unauthorized hardware device access
  Header set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(self)"

  # Remove server identification header if possible
  Header unset X-Powered-By
</IfModule>

# Block access to hidden files and sensitive directories (.git, .env, etc.)
<FilesMatch "(^\.|\.env|\.git|\.json$|\.md$|\.sql$|\.bak$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 4. GZIP & BROTLI COMPRESSION (mod_deflate)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/eot
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ------------------------------------------------------------------------------
# 5. BROWSER CACHING & LEVERAGE CACHE HEADERS (mod_expires & mod_headers)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML documents - 1 hour with revalidation
  ExpiresByType text/html "access plus 1 hour"

  # CSS and JavaScript - 1 month
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"

  # Images, Favicons, Graphics - 1 year
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # Audio and Media - 1 year
  ExpiresByType audio/mpeg "access plus 1 year"
  ExpiresByType audio/mp3 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"

  # Web Fonts - 1 year
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # Feeds & Manifests - 1 hour
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # Cache-Control Headers for Static Assets
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|ttf|otf|mp3|mp4)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>

  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 6. MIME TYPES CONFIGURATION
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType application/json .json
  AddType audio/mpeg .mp3
  AddType video/mp4 .mp4
</IfModule>
